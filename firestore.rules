rules_version = '2';

// counseled.app was decommissioned on 2026-11-08. All client access is denied.
// Data export: gs://counseled-cds-archive/firestore-final-2026-11-08
// Last active rules: see git history (commit cfbfa2f) to resurrect.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
